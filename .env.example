# Copy this file to .env and fill it in. Leave a value empty to run that part in MOCK mode.
# With everything empty, the whole demo runs offline with clearly labelled mock data.

# PayPal SANDBOX app (developer.paypal.com > Apps & Credentials > Sandbox).
# Make Good refuses to talk to any PayPal host except the sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same sandbox app (only needed once the app is deployed).
PAYPAL_WEBHOOK_ID=

# Optional: a PayPal sandbox TEST card (from the dashboard's card generator), used only by the
# seed script to create test payments without approving each one by hand.
PAYPAL_TEST_CARD_NUMBER=
PAYPAL_TEST_CARD_EXPIRY=
PAYPAL_TEST_CARD_CVV=

# Claude (console.anthropic.com). Without it, rule drafting and claim reading fall back to
# simple built-in rules, labelled MOCK on screen.
ANTHROPIC_API_KEY=
MAKEGOOD_MODEL=claude-opus-5-5

PUBLIC_URL=http://localhost:3000
PORT=3000
