{
  "name": "@makegood/api",
  "version": "0.2.0",
  "private": true,
  "description": "Make Good backend: API server and durable worker in one codebase.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "worker": "node src/worker.ts",
    "migrate": "node src/platform/db/migrate-cli.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.ts",
    "sandbox": "node scripts/sandbox-verify.ts",
    "sandbox:recall": "node scripts/sandbox-recall.ts",
    "ai:verify": "node scripts/ai-verify.ts",
    "test:e2e": "node scripts/demo-capture.ts --fast",
    "demo:capture": "node scripts/demo-capture.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/multipart": "*",
    "@fastify/static": "*",
    "fastify": "^5.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5"
  }
}
