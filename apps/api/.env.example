# Copy to apps/api/.env. Every value is optional for local work.
# Never commit .env.

# ---- Server ----
PORT=4000
PUBLIC_URL=http://localhost:4000
# development | production
NODE_ENV=development

# ---- Database ----
# Leave empty to use the built-in local database (stored in apps/api/.data).
# Set a PostgreSQL connection string in production and for running the worker as its own process.
DATABASE_URL=

# ---- Secrets at rest ----
# 32 random bytes, base64. Encrypts PayPal and store credentials in the database.
# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In development a key is created for you in apps/api/.data/dev-encryption.key.
MAKEGOOD_ENCRYPTION_KEY=

# ---- PayPal ----
# PayPal credentials are NOT set here. Each merchant connects their own account
# on the Settings screen, and the secret is stored encrypted.
#
# Live PayPal is refused unless this is set to exactly:
#   I understand this moves real money
ALLOW_LIVE_PAYPAL=
# The built-in simulator (no PayPal calls). On in development, off in production. 1 or 0.
ALLOW_SIMULATOR=
# Platform credentials for PayPal seller onboarding. Only for an approved PayPal partner.
PAYPAL_PARTNER_CLIENT_ID=
PAYPAL_PARTNER_CLIENT_SECRET=

# ---- AI (reading claim evidence) ----
ANTHROPIC_API_KEY=
MAKEGOOD_MODEL=claude-opus-5-5

# ---- Email ----
# file: write emails to apps/api/.data/outbox instead of sending. resend: send through Resend.
EMAIL_TRANSPORT=file
RESEND_API_KEY=
EMAIL_FROM=Make Good <notices@example.com>

# ---- Exchange rates ----
# European Central Bank reference rates through the public Frankfurter API. Indicative only.
FX_API_URL=https://api.frankfurter.dev/v1

# ---- Jobs ----
# 1: the API process also runs the job worker (default in development).
# 0: run `npm run worker` as its own process (needs DATABASE_URL).
WORKER_INLINE=
LOG_LEVEL=info
